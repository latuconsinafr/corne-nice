#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

&mt { flavor = "tap-preferred"; };

&sk {
    release-after-ms = <2000>;
    quick-release;
};

/ {
    behaviors {
        // Custom mod-tap with one-shot shift on tap

        mt_sk: mod_tap_sticky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&sk>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <38 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // -----------------------------------------------------------------------------------------
            // |  `   |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | DEL  |
            // | TAB  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  | '    |
            // | LALT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | RSHFT|
            //                    | OS_SFT/GUI | SYM | SPC |   | BSP | NAV | OS_SFT/CTL |
            // OS_SFT = One-Shot Shift: tap=shift next key, hold=GUI/CTRL

            bindings = <
&kp GRAVE  &kp Q  &kp W  &kp E      &kp R      &kp T                   &kp Y                      &kp U      &kp I      &kp O    &kp P     &kp DEL
&kp TAB    &kp A  &kp S  &kp D      &kp F      &kp G                   &kp H                      &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LALT   &kp Z  &kp X  &kp C      &kp V      &kp B                   &kp N                      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RC(RG(SPACE))
                         &kp LCTRL  &lt 1 ESC  &mt LEFT_SHIFT SPACE    &mt RIGHT_SHIFT BACKSPACE  &lt 2 RET  &kp RGUI
            >;
        };

        symbol_layer {
            // -----------------------------------------------------------------------------------------
            // |  `   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | DEL  |
            // | TAB  |     |     |     |     |     |   |  -  |  [  |  ]  |  =  |  +  |  '   |
            // | LALT |     |     |     |     |     |   |  _  |  {  |  }  |  |  |  \  | RSHFT|
            //                    | OS_SFT/GUI |     | SPC |   | BSP |     | OS_SFT/CTL |

            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPS  &kp STAR  &kp LPAR   &kp RPAR       &trans
&trans  &trans    &trans  &trans    &trans      &trans         &kp MINUS  &kp LBKT  &kp RBKT  &kp EQUAL  &kp PLUS       &trans
&trans  &trans    &trans  &trans    &trans      &trans         &kp UNDER  &kp LBRC  &kp RBRC  &kp PIPE   &kp BACKSLASH  &trans
                          &trans    &trans      &trans         &trans     &trans    &trans
            >;
        };

        nav_layer {
            // -----------------------------------------------------------------------------------------
            // |  `   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | DEL  |
            // | TAB  |     | HOME| PGUP| PGDN| END |   | LFT | DWN |  UP | RGT |     |  '   |
            // | LALT |     |     |     |     |     |   |CMD+OPT+←|CMD+OPT+↓|CMD+OPT+↑|CMD+OPT+→|     |RSHFT|
            //                    | OS_SFT/GUI |     | SPC |   | BSP |     | OS_SFT/CTL |

            bindings = <
&trans  &kp N1  &kp N2            &kp N3                &kp N4            &kp N5               &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &trans
&trans  &trans  &kp HOME          &kp PG_UP             &kp PG_DN         &kp END              &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans  &kp LG(LA(LEFT))  &kp LG(LA(UP_ARROW))  &kp LG(LA(DOWN))  &kp LG(LA(RIGHT))    &trans    &trans    &trans  &trans     &trans  &trans
                                  &trans                &trans            &trans               &trans    &trans    &trans
            >;
        };

        adjust_layer {
            // -----------------------------------------------------------------------------------------
            // |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |   |  F7  |  F8  |  F9  | F10  | F11  | F12  |
            // | TAB  | BRI- | BRI+ |SHOALL|SEARCH| MUTE |   | PREV | PLAY | NEXT | VOL- | VOL+ |  '   |
            // | LALT |EP_ON |EP_OFF|      |      | CAPS |   |BTCLR | BT0  | BT1  | BT2  | BT3  |RSHFT |
            //                      | OS_SFT/GUI |      |      |   |      |      | OS_SFT/CTL |

            bindings = <
&kp F1  &kp F2                &kp F3          &kp F4                             &kp F5                    &kp F6                  &kp F7      &kp F8        &kp F9        &kp F10           &kp F11            &kp F12
&trans  &kp C_BRI_DN          &kp C_BRI_UP    &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp C_AC_SEARCH           &kp C_MUTE              &kp C_PREV  &kp C_PP      &kp C_NEXT    &kp C_VOL_DN      &kp C_VOL_UP       &trans
&trans  &kp LG(LS(NUMBER_3))  &kp LG(LS(N5))  &kp DOWN                           &kp LG(LS(LC(NUMBER_4)))  &kp LG(LS(NUMBER_4))    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &ext_power EP_ON  &ext_power EP_OFF  &trans
                                              &trans                             &trans                    &trans                  &trans      &trans        &trans
            >;
        };
    };
};
